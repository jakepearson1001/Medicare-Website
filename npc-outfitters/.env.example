# -----------------------------------------------------------------------
# NPC Outfitters — environment variables
# Copy this file to .env.local and fill in what you have. Everything here
# is optional: the site runs fully in "mock mode" with none of it set.
# -----------------------------------------------------------------------

# Public site URL — used for metadata, sitemap.xml, robots.txt, OG images.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Payments: Square (primary checkout path) ---------------------------
# Square Developer Dashboard → your app → Credentials.
# See src/lib/payments/square.ts for exactly where these get used.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
NEXT_PUBLIC_SQUARE_APP_ID=
SQUARE_ENV=sandbox
# Shown to buyers on Square's confirmation page (optional).
SQUARE_SUPPORT_EMAIL=

# --- Square webhook (this is what triggers fulfillment) ------------------
# Square Developer Dashboard → your app → Webhooks → Add subscription.
# Subscribe to `payment.updated`, then paste the signature key here.
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Must byte-for-byte match the URL registered in Square, because the
# signature is computed over it. Example:
#   https://npc-outfitters.vercel.app/api/webhooks/square
SQUARE_WEBHOOK_URL=

# --- Fulfillment: Printful (primary fulfillment path) --------------------
# Printful dashboard → Settings → API.
# See src/lib/fulfillment/printful.ts for exactly where this gets used.
PRINTFUL_API_KEY=
# "true" submits orders straight to production. Leave unset/false while
# testing so orders land as drafts you confirm by hand first.
PRINTFUL_AUTO_CONFIRM=false

# --- Optional alternative: Shopify Storefront API -------------------------
# Only needed if you'd rather run commerce through Shopify instead of
# Square + Printful directly. See src/lib/commerce/shopify-provider.ts.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# --- Email capture ("JOIN THE SERVER") ------------------------------------
# Set ONE of these. See src/app/api/subscribe/route.ts.
KLAVIYO_API_KEY=
KLAVIYO_LIST_ID=
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=

# --- Analytics -------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
